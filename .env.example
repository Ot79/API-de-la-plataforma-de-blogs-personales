# Entorno: development | test | production
NODE_ENV=development
PORT=3000

# Cadena de conexión a PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blog?schema=public

# Secreto para firmar los access tokens (mínimo 32 caracteres).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Duración del access token (formato ms/jsonwebtoken: 15m, 1h, 7d...)
JWT_ACCESS_EXPIRES_IN=15m
# Días de validez del refresh token
REFRESH_TOKEN_TTL_DAYS=7

# Orígenes permitidos por CORS separados por coma ("*" para todos)
CORS_ORIGIN=*

# Número de proxies inversos de confianza delante de la API (balanceador, PaaS...).
# 0 si la API recibe las conexiones directamente; 1 detrás de Render, Railway, Nginx...
TRUST_PROXY=0

# Rate limiting (ventana en ms y peticiones máximas por IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Nivel de logs: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
